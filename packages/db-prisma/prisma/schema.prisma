datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

/// EXAMPLE — remove via the scaffold CLI.
model Item {
  id        String   @id @default(cuid())
  tenantId  String   @default("demo")
  name      Json
  sku       String
  price     Decimal  @db.Decimal(12, 2)
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sku])
}

/// A person who can sign in. There is no tenant column: each deployment has its own database.
model User {
  id            String         @id @default(cuid())
  /// The person's name. One string. Role labels stay translated JSON.
  name          String?
  email         String?        @unique
  phone         String?        @unique
  /// Google account subject (`sub`). Set when this person signs in with Google.
  googleSubject String?        @unique
  passwordHash  String?
  /// Set when an operator deactivates the user. Null means they can sign in.
  deactivatedAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  userRoles     UserRole[]
}

/// Hashed refresh session. The cookie holds the raw token; this row stores only the hash.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Allow-or-deny action. The key comes from the code catalog, not from an operator.
model Permission {
  id        String           @id @default(cuid())
  key       String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  grants    RolePermission[]
}

/// Named bundle of permissions. The system role is found by slug `owner`.
model Role {
  id        String           @id @default(cuid())
  slug      String           @unique
  label     Json
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  grants    RolePermission[]
  holders   UserRole[]
}

/// Grant of one permission to one role. Boot rewrites the owner role's rows.
model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

/// Assignment of one role to one user. The first registered user receives owner.
model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}
