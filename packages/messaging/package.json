{
  "name": "@core/messaging",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Opt-in OTP, email, MsgPlus SMS, and Twilio WhatsApp. Not wired into the API until an app imports it.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "import": "./dist/nest/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "echo skip",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "nodemailer": "^7.0.12",
    "twilio": "^5.11.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": { "optional": true },
    "@nestjs/core": { "optional": true }
  },
  "devDependencies": {
    "@core/typescript-config": "workspace:*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.4",
    "reflect-metadata": "^0.2.2",
    "typescript": "^7.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
