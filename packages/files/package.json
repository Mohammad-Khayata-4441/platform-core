{
  "name": "@core/files",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "File upload, read, and delete. The app passes a Prisma delegate and the environment picks the storage driver.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "import": "./dist/nest/index.js"
    },
    "./s3": {
      "types": "./dist/s3.d.ts",
      "import": "./dist/s3.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "echo skip",
    "check-types": "tsc --noEmit",
    "test": "echo skip"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@core/auth": "workspace:*",
    "@nestjs/swagger": "^12.0.2",
    "multer": "2.4.0",
    "rxjs": "^7.8.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0"
  },
  "devDependencies": {
    "@core/typescript-config": "workspace:*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "reflect-metadata": "^0.2.2",
    "typescript": "^7.0.0"
  }
}
